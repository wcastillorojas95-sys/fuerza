<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET, y conviene saber lo que costo.

        Fuerza nacio sin este permiso a proposito. Sin el, "tus entrenos no
        pueden salir del telefono" no era una promesa: era una restriccion que
        imponia el sistema, y no habia que fiarse de nadie para creersela.

        Se anadio para poder ver el video del ejercicio dentro de la app en vez
        de saltar a YouTube. A partir de aqui esa garantia pasa a ser confianza.
        Lo que sigue siendo cierto y se puede comprobar leyendo el codigo:

          - Los entrenos siguen en un JSON de la carpeta privada de la app.
            Nadie los lee ni los envia a ningun sitio.
          - No hay analitica, ni cuentas, ni servidor propio. La unica conexion
            que abre la app es el reproductor de YouTube, y solo cuando tocas
            un video que has fijado tu.
          - El catalogo, las demostraciones y las rutinas siguen compilados
            dentro del APK, asi que en un sotano sin cobertura la app funciona
            entera menos el video.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Aviso de fin de descanso. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Mantiene la pantalla encendida mientras registras una serie, para no
        tener que desbloquear el telefono con las manos llenas de magnesio.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fuerza">

        <!--
            La rotacion la lleva la app, no el sistema.

            Sin android:configChanges, girar el telefono destruye y recrea la
            Activity. Eso importa aqui por el video a pantalla completa: al
            expandirlo se pide horizontal, y sin esta linea la recreacion se
            llevaria por delante el popup entero justo al abrirlo. Compose
            recoloca solo lo que haga falta, asi que no se pierde nada.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Fuerza"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Quien avisa de que se acabo el descanso.

            No es un servicio en primer plano: es un BroadcastReceiver que
            dispara AlarmManager. Un servicio obligaria a declarar tipo desde
            Android 14 y a pelearse con los limites de tiempo; setAlarmClock, en
            cambio, es exacto, atraviesa el modo Doze y no pide ningun permiso
            especial. El precio es el iconito de alarma en la barra, que ademas
            avisa de que el descanso corre.
        -->
        <receiver
            android:name=".AvisoDescanso"
            android:exported="false" />

    </application>

</manifest>
